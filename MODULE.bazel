http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

new_local_repository(
    name = "whereami",
    build_file = "//bazel/third_party:whereami.BUILD",
    path = "src/external/whereami",
)

new_local_repository(
    name = "libxcf",
    build_file = "//bazel/third_party:libxcf.BUILD",
    path = "src/external/libxcf",
)

new_local_repository(
    name = "lua_internal",
    build_file = "//bazel/third_party:lua.BUILD",
    path = "src/external/lua",
)

new_local_repository(
    name = "lautoc",
    build_file = "//bazel/third_party:lautoc.BUILD",
    path = "src/external/LuaAutoC",
)

new_local_repository(
    name = "libraw_internal",
    build_file = "//bazel/third_party:libraw.BUILD",
    path = "src/external/LibRaw",
)

new_local_repository(
    name = "rawspeed",
    build_file = "//bazel/third_party:rawspeed.BUILD",
    path = "src/external/rawspeed",
)


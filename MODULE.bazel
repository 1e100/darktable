archive_override(
    module_name = "libjxl",
    integrity = "sha256-qziSj39iSOKpjMGElWAhrLknsWoN7nG00mDcBApDIOo=",
    patch_strip = 0,
    patches = [
        "//third_party/jxl:libjxl_build_rules_cc.patch",
        "//third_party/jxl:libjxl_module_rules_cc.patch",
    ],
    strip_prefix = "libjxl-0.11.2",
    urls = ["https://github.com/libjxl/libjxl/archive/refs/tags/v0.11.2.tar.gz"],
)

pkg_config_repository = use_repo_rule("//bazel:pkg_config.bzl", "pkg_config_repository")

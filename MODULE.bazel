module(name = "darktable", version = "0.0.0")

bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "libjpeg_turbo", version = "3.1.3.bcr.4")
bazel_dep(name = "libavif", version = "1.4.1")
bazel_dep(name = "libheif", version = "1.21.2")
bazel_dep(name = "libpng", version = "1.6.54")
bazel_dep(name = "libtiff", version = "4.7.1")
bazel_dep(name = "libwebp", version = "1.6.0")
bazel_dep(name = "libxml2", version = "2.15.3")
bazel_dep(name = "icu", version = "78.2")
bazel_dep(name = "imath", version = "3.2.2.bcr.1")
bazel_dep(name = "openexr", version = "3.4.10")
bazel_dep(name = "pugixml", version = "1.15")
bazel_dep(name = "sqlite3", version = "3.51.2.bcr.1")
bazel_dep(name = "zlib", version = "1.3.2")

single_version_override(
    module_name = "libpng",
    patches = ["//third_party/png:libpng_no_config.patch"],
    patch_strip = 0,
    version = "1.6.54",
)

single_version_override(
    module_name = "libwebp",
    patches = ["//third_party/webp:libwebp_no_config.patch"],
    patch_strip = 0,
    version = "1.6.0",
)

single_version_override(
    module_name = "libxml2",
    patches = ["//third_party/xml:libxml2_no_package_config_leak.patch"],
    patch_strip = 0,
    version = "2.15.3",
)

single_version_override(
    module_name = "openexr",
    patches = ["//third_party/openexr:openexr_default_source.patch"],
    patch_strip = 0,
    version = "3.4.10",
)

pkg_config_repository = use_repo_rule("//bazel:pkg_config.bzl", "pkg_config_repository")
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

new_local_repository(
    name = "whereami",
    build_file = "//bazel/third_party:whereami.BUILD",
    path = "src/external/whereami",
)

new_local_repository(
    name = "libxcf",
    build_file = "//bazel/third_party:libxcf.BUILD",
    path = "src/external/libxcf",
)

new_local_repository(
    name = "lua_internal",
    build_file = "//bazel/third_party:lua.BUILD",
    path = "src/external/lua",
)

new_local_repository(
    name = "lautoc",
    build_file = "//bazel/third_party:lautoc.BUILD",
    path = "src/external/LuaAutoC",
)

new_local_repository(
    name = "libraw_internal",
    build_file = "//bazel/third_party:libraw.BUILD",
    path = "src/external/LibRaw",
)

new_local_repository(
    name = "rawspeed",
    build_file = "//bazel/third_party:rawspeed.BUILD",
    path = "src/external/rawspeed",
)

http_archive(
    name = "lcms2",
    build_file = "//third_party/lcms2:lcms2.BUILD",
    sha256 = "49e7e134e4299733dd0eda434fa468997a28ab3d33fa397c642b03644f552216",
    strip_prefix = "lcms2-2.19",
    urls = ["https://github.com/mm2/Little-CMS/releases/download/lcms2.19/lcms2-2.19.tar.gz"],
)

http_archive(
    name = "openjpeg",
    build_file = "//third_party/openjpeg:openjpeg.BUILD",
    patch_args = ["-p1"],
    patches = ["//third_party/openjpeg:openjpeg_config.patch"],
    sha256 = "a695fbe19c0165f295a8531b1e4e855cd94d0875d2f88ec4b61080677e27188a",
    strip_prefix = "openjpeg-2.5.4",
    urls = ["https://github.com/uclouvain/openjpeg/archive/refs/tags/v2.5.4.tar.gz"],
)

http_archive(
    name = "darktable_icu_dat",
    build_file_content = """filegroup(
    name = "icu_dat",
    srcs = ["source/data/in/icudt78l.dat"],
    visibility = ["//visibility:public"],
)""",
    integrity = "sha256-Pploe1xDXUsgljDi0uu3mQbJhGheeGNQeLZy4DyJ3zU=",
    strip_prefix = "icu",
    urls = ["https://github.com/unicode-org/icu/releases/download/release-78.2/icu4c-78.2-sources.tgz"],
)

pkg_config_repository(
    name = "gtk_stack",
    packages = [
        "gtk+-3.0 >= 3.24.15",
        "glib-2.0 >= 2.56",
        "gio-2.0",
        "gmodule-2.0",
        "gthread-2.0",
        "gdk-pixbuf-2.0",
        "cairo",
        "pango",
        "pangocairo",
        "atk",
        "librsvg-2.0",
        "json-glib-1.0",
    ],
)

# Transitional probe target used while native hermetic third-party archives are
# added one by one. The GTK stack above is the intended long-term system
# exception; this target makes early Linux build evaluation expose concrete
# missing host packages instead of failing later with unresolved compiler flags.
pkg_config_repository(
    name = "darktable_linux_system_probe",
    packages = [
        "libcurl >= 7.56",
        "exiv2 >= 0.27.2",
        "lensfun",
        "libgphoto2 >= 2.5",
        "libjxl >= 0.7.0",
        "libjxl_threads",
        "wayland-client",
        "GraphicsMagick",
    ],
)

pkg_config_repository(
    name = "darktable_linux_optional_desktop",
    packages = [
        "colord",
        "colord-gtk",
        "libsecret-1",
        "osmgpsmap-1.0",
        "portmidi",
    ],
)

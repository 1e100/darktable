common --enable_bzlmod
common --announce_rc
common --experimental_convenience_symlinks=normal
common --noexperimental_collect_system_network_usage

build --cxxopt=-std=c++20
build --conlyopt=-std=c99
build --copt=-fPIC
build --copt=-DHAVE_CONFIG_H
build --copt=-D_XOPEN_SOURCE=700
build --linkopt=-lm

build:linux --cpu=k8
build:linux --copt=-DDT_BAZEL_BUILD
build:linux --copt=-fopenmp
build:linux --linkopt=-fopenmp
build:linux --linkopt=-Wl,--enable-new-dtags
build:linux --sandbox_add_mount_pair=/usr/include
build:linux --sandbox_add_mount_pair=/usr/lib/x86_64-linux-gnu

# AddressSanitizer: heap corruption, buffer overflows, use-after-free
# Note: target //src:darktable-cli for ASan testing — it links statically and
# avoids the cc_import/shared-library link-graph issues that affect //src:darktable.
build:asan --copt=-fsanitize=address
build:asan --copt=-fno-omit-frame-pointer
build:asan --copt=-O1
build:asan --linkopt=-fsanitize=address

# MemorySanitizer: uninitialized reads (requires all deps compiled with msan)
build:msan --copt=-fsanitize=memory
build:msan --copt=-fno-omit-frame-pointer
build:msan --copt=-O1
build:msan --linkopt=-fsanitize=memory

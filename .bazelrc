common --enable_bzlmod
common --announce_rc
common --experimental_convenience_symlinks=normal
common --noexperimental_collect_system_network_usage

build --cxxopt=-std=c++20
build --conlyopt=-std=c99
build --copt=-fPIC
build --copt=-DHAVE_CONFIG_H
build --copt=-D_XOPEN_SOURCE=700
build --linkopt=-lm

build:linux --cpu=k8
build:linux --copt=-DDT_BAZEL_BUILD
build:linux --copt=-fopenmp
build:linux --linkopt=-fopenmp
build:linux --linkopt=-Wl,--enable-new-dtags
build:linux --sandbox_add_mount_pair=/usr/include
build:linux --sandbox_add_mount_pair=/usr/lib/x86_64-linux-gnu

cc_binary(
    name = "libdarktable.so",
    srcs = [],
    linkopts = [
        "-shared",
        "-Wl,-soname,libdarktable.so",
        "-Wl,-rpath,$$ORIGIN",
    ],
    linkshared = True,
    linkstatic = False,
    deps = [":darktable_core_compile"],
)

cc_binary(
    name = "darktable",
    srcs = ["main.c"],
    copts = COMMON_COPTS,
    includes = COMMON_INCLUDES,
    linkopts = ["-Wl,-rpath,$$ORIGIN/../lib/darktable"],
    deps = [":darktable_core_compile"],
)


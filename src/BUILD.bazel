cc_library(
    name = "darktable_public_headers",
    hdrs = CORE_HDRS + GENERATED_HDRS,
    copts = COMMON_COPTS,
    includes = COMMON_INCLUDES + ["."],
    deps = [
        "@darktable_linux_system_probe//:pkg",
        "@gtk_stack//:pkg",
    ],
)

CORE_DEPS = [
    ":darktable_public_headers",
    "@lautoc//:lautoc",
    "@lua_internal//:lua",
    "@whereami//:whereami",
    "@darktable_linux_system_probe//:pkg",
    "@gtk_stack//:pkg",
]

cc_library(
    name = "potrace_system",
    linkopts = ["-lpotrace"],
)


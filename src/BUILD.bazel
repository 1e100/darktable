genrule(
    name = "darktable-bazel-launcher",
    srcs = [
        ":bazel_runtime_tree",
        ":darktable",
    ],
    outs = ["darktable-bazel"],
    cmd = "\n".join([
        "cat > $@ <<'EOF'",
        "#!/bin/sh",
        "set -eu",
        "self=$$(CDPATH= cd -- \"$$(dirname -- \"$$0\")\" && pwd)",
        "exec \"$$self/darktable-runtime/bin/darktable-bazel\" \"$$@\"",
        "EOF",
        "chmod +x $@",
    ]),
)

